import cv2
import numpy as np
import time
vid=cv2.VideoCapture("images\\video.mp4")
for i in range (30):
    return_value,bg=vid.read()
    if return_value==False :
        continue
bg=np.flip(bg,axis=1)
count=0
while(vid.isOpened()):
    return_value,img=vid.read()
    if return_value==False :
        break
    count=count+1
    img=np.flip(img,axis=1)
    hsvimg=cv2.cvtColor(img,cv2.COLOR_BGR2HSV)

    lower_red=np.array([100,40,40])
    upper_red=np.array([100,255,255])
    lower_red2=np.array([155,40,40])
    upper_red2=np.array([180,255,255])
    mask1=cv2.inRange(hsvimg,lower_red,upper_red)
    mask2=cv2.inRange(hsvimg,lower_red2,upper_red2)
    mask1=mask1+mask2
    mask1=cv2.morphologyEx(mask1,cv2.MORPH_OPEN,np.ones((3,3),np.uint8),iterations=2)
    mask1=cv2.dilate(mask1,np.ones((3,3),np.uint8),iterations=1)
    mask2=cv2.bitwise_not(mask1)
    result1=cv2.bitwise_and(bg,bg,mask=mask1)
    result2=cv2.bitwise_and(img,img,mask=mask2)
    img=cv2.addWeighted(result1,1,result2,1,0)
    cv2.imshow("vid",img)
    k=cv2.waitKey(10)
    if k==27:
        break